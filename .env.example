# Copy to .env (never commit .env)

# --- backend ---
CONDUIT_HOST=127.0.0.1
CONDUIT_PORT=8000
CONDUIT_DB_URL=sqlite:///data/conduit.db
CONDUIT_CORS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# --- camera ---
CONDUIT_CAMERA_INDEX=0

# --- device mode: simulation (default, no hardware needed) or hardware ---
CONDUIT_MODE=simulation

# --- Arduino Uno node over USB serial (COM3, /dev/ttyACM0, /dev/cu.usbmodem...) ---
CONDUIT_SERIAL_PORT=
CONDUIT_SERIAL_BAUD=9600

# Optional: custom location of the MediaPipe hand_landmarker.task model (offline use)
# CONDUIT_HAND_MODEL=backend/vision/assets/hand_landmarker.task
